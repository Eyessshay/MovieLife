# Required for application startup. Copy this file to .env only for local use.
MYSQL_PASSWORD=<replace-with-local-mysql-password>

# Optional infrastructure overrides.
MYSQL_URL=jdbc:mysql://localhost:3306/movielife?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
# Set only when Redis authentication is enabled.
# SPRING_REDIS_PASSWORD=<replace-with-local-redis-password>
SERVER_PORT=8081

# Safe delivery defaults.
AUTH_LOG_CODE_ENABLED=false
STARTUP_CHECK_ENABLED=true
AI_REVIEW_SUMMARY_ENABLED=false

# Required together only when AI_REVIEW_SUMMARY_ENABLED=true.
AI_REVIEW_SUMMARY_ENDPOINT=https://provider.example/v1/chat/completions
AI_REVIEW_SUMMARY_API_KEY=<replace-with-provider-key>
AI_REVIEW_SUMMARY_MODEL=<replace-with-provider-model>

# Optional AI tuning. Keep these defaults unless the provider or workload requires a change.
AI_REVIEW_SUMMARY_CONNECT_TIMEOUT=3s
AI_REVIEW_SUMMARY_READ_TIMEOUT=45s
AI_REVIEW_SUMMARY_MAX_RESPONSE_BYTES=16384
AI_REVIEW_SUMMARY_MIN_REVIEWS=3
AI_REVIEW_SUMMARY_MAX_REVIEWS=100
AI_REVIEW_SUMMARY_MAX_REVIEW_CHARACTERS=1000
AI_REVIEW_SUMMARY_MAX_INPUT_CHARACTERS=20000
AI_REVIEW_SUMMARY_MAX_ATTEMPTS=3
AI_REVIEW_SUMMARY_LEASE_DURATION=2m
AI_REVIEW_SUMMARY_PENDING_CLAIM_MIN_IDLE=2m
AI_REVIEW_SUMMARY_STREAM_BATCH_SIZE=10
AI_REVIEW_SUMMARY_RECOVERY_BATCH_SIZE=100
AI_REVIEW_SUMMARY_WORKER_FIXED_DELAY_MS=1000
AI_REVIEW_SUMMARY_WORKER_INITIAL_DELAY_MS=5000
AI_REVIEW_SUMMARY_PENDING_RECOVERY_FIXED_DELAY_MS=5000
AI_REVIEW_SUMMARY_PENDING_RECOVERY_INITIAL_DELAY_MS=10000
AI_REVIEW_SUMMARY_RECONCILIATION_FIXED_DELAY_MS=30000
AI_REVIEW_SUMMARY_RECONCILIATION_INITIAL_DELAY_MS=15000
